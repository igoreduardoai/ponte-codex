{
  "name": "ponte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "fixture": "node --env-file-if-exists=.env src/server.js --fixture",
    "auth": "node --env-file-if-exists=.env src/auth.js",
    "test": "node --test",
    "eval": "node --env-file-if-exists=.env src/eval.js",
    "eval:50": "node --env-file-if-exists=.env src/eval.js data/eval-50.jsonl docs/eval-50-report.json",
    "session:id": "node scripts/session-id.js",
    "check:live": "node --env-file-if-exists=.env scripts/live-preflight.js",
    "test:groq": "node --env-file-if-exists=.env scripts/groq-smoke.js",
    "test:twitch": "node --env-file-if-exists=.env scripts/twitch-smoke.js"
  }
}
